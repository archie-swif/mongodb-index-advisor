   },
   "cell_type": "code",
   "source": [
    "# Collect query stats\n",
    "\n",
    "server_status = mongodb_client.admin.command(\"serverStatus\")\n",
    "cluster_name = server_status[\"repl\"][\"primary\"].split(\"-shard\")[0]\n",
    "\n",
    "# Query statistics\n",
    "# https://www.mongodb.com/docs/manual/reference/operator/aggregation/queryStats/\n",
    "query_stats_response = list(mongodb_client.get_database(\"admin\").aggregate([\n",
    "    {\"$queryStats\": {}},\n",
    "    {\"$match\": {\n",
    "        \"key.queryShape.cmdNs.db\": {\"$not\": {\"$in\": [\"admin\", \"local\", \"config\"]}},\n",
    "        \"metrics.totalExecMicros.sum\": {\"$gt\": 10000}\n",
    "    }},\n",
    "    {\"$sort\": {\"metrics.totalExecMicros.sum\": -1}},\n",
    "    {\"$project\": {\n",
    "        \"db\": \"$key.queryShape.cmdNs.db\",\n",
    "        \"coll\": \"$key.queryShape.cmdNs.coll\",\n",
    "        \"hash\": {\"$concat\": [\"#\", {\"$substr\": [{\"$ifNull\": [\"$queryShapeHash\", \"000000\"]}, 0, 6]}]},\n",
    "        \"shape\": \"$key.queryShape\",\n",
    "        \"raw\": \"$$ROOT\"\n",
    "    }},\n",
    "    {\"$project\": {\n",
    "        \"shape.cmdNs\": 0,\n",
    "    }},\n",
    "\n",
    "    {\"$group\": {\n",
    "        \"_id\": {\"db\": \"$db\", \"coll\": \"$coll\"},\n",
    "        \"stats\": {\"$push\": \"$$ROOT\"}\n",
    "    }},\n",
    "    {\"$project\": {\n",
    "        \"_id\": 0,\n",
    "        \"ns.cluster_name\": cluster_name,\n",
    "        \"ns.database_name\": \"$_id.db\",\n",
    "        \"ns.collection_name\": \"$_id.coll\",\n",
    "        \"stats\": \"$stats\"\n",
    "    }}\n",
    "]))\n"
   ],
   "id": "f855e812cc8c7712",
   "outputs": [],
   "execution_count": 2
  },
  {
   "metadata": {
    "ExecuteTime": {
     "end_time": "2025-03-18T21:30:04.403195Z",
     "start_time": "2025-03-18T21:22:35.032959Z"
    }
   },
   "cell_type": "code",
   "source": [
    "# Create a notebook for each collection\n",
    "for res in query_stats_response:\n",
    "    namespace = res[\"ns\"]\n",
    "    query_stats = res[\"stats\"]\n",
    "\n",
    "    query_stats_with_description = []\n",
    "\n",
    "    for qs in query_stats:\n",
    "        shape = qs[\"shape\"]\n",
    "        is_internal_command = bool(re.search(\"collStats|queryStats|indexStats|listSearchIndexes\", f'{shape}'))\n",
    "        if is_internal_command:\n",
    "            continue\n",
    "\n",
    "        qsd = add_details_to_query_stats(namespace, qs)\n",
    "        query_stats_with_description.append(qsd)\n",
    "\n",
    "    # Don't create a notebook if no major queries were found\n",
    "    if len(query_stats_with_description) == 0:\n",
    "        continue\n",
    "\n",
    "    create_summary_notebook(namespace)\n",
    "    \n",
    "    # Create a notebook for eaach query\n",
    "    for qs in query_stats_with_description:\n",
    "        create_query_notebook(namespace | qs)"
   ],
   "id": "ba35b96e3225b930",

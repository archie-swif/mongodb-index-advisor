   },
   "cell_type": "code",
   "source": [
    "# Initialize\n",
    "import os\n",
    "import re\n",
    "from string import Template\n",
    "\n",
    "import nbformat\n",
    "import requests\n",
    "from anthropic import Anthropic\n",
    "from bs4 import BeautifulSoup\n",
    "from dotenv import load_dotenv\n",
    "from pymongo import MongoClient\n",
    "\n",
    "load_dotenv()\n",
    "\n",
    "uri = os.getenv(\"MONGO_URI\")\n",
    "mongodb_client = MongoClient(uri)\n",
    "\n",
    "anthropic_client = Anthropic()\n",
    "base_context = []\n",
    "\n",
    "\n",
    "def webpage_as_context(url):\n",
    "    response = requests.get(url)\n",
    "    soup = BeautifulSoup(response.text, 'html.parser')\n",
    "    body = soup.select('div.body')[0]\n",
    "    text = body.get_text(separator=\" \", strip=True)\n",
    "    return {\n",
    "        \"role\": \"user\",\n",
    "        \"content\": f\"MongoDB documentation from {url}\\n{text}\",\n",
    "    }\n",
    "\n",
    "\n",
    "docs = [\n",
    "    \"https://www.mongodb.com/docs/manual/reference/operator/aggregation/queryStats/\",\n",
    "    \"https://www.mongodb.com/docs/manual/core/query-shapes/\"\n",
    "]\n",
    "\n",
    "for url in docs:\n",
    "    context_message = webpage_as_context(url)\n",
    "    base_context.append(context_message)\n",
    "\n",
    "\n",
    "def get_query_header(query_shape):\n",
    "    !sleep 5\n",
    "    context = base_context.copy()\n",
    "    context.extend([\n",
    "        {\n",
    "            \"role\": \"user\",\n",
    "            \"content\": f\"Here is an example Query Shape from the $queryStats output. Generate a 3 to 10 word description for the query purpose. Don't wrap in quotes\"\n",
    "        },\n",
    "        {\n",
    "            \"role\": \"user\",\n",
    "            \"content\": f\"Query Shape: {query_shape}\",\n",
    "        }\n",
    "    ])\n",
    "    response = anthropic_client.messages.create(\n",
    "        max_tokens=1024,\n",
    "        messages=context,\n",
    "        model=\"claude-3-7-sonnet-latest\",\n",
    "    )\n",
    "\n",
    "    return response.content[0].text\n",
    "\n",
    "\n",
    "def get_query_details(query_stats):\n",
    "    !sleep 5\n",
    "    context = base_context.copy()\n",
    "    context.extend([\n",
    "        {\n",
    "            \"role\": \"user\",\n",
    "            \"content\": f\"Here is an output from the $queryStats. Generate a short summary for the query purpose and metrics. Use markdown. For headers use only '#####' - Heading level 5, otherwise you will break formatting.\",\n",
    "        },\n",
    "        {\n",
    "            \"role\": \"user\",\n",
    "            \"content\": f\"Query stats: {query_stats}\",\n",
    "        }\n",
    "    ])\n",
    "\n",
    "    response = anthropic_client.messages.create(\n",
    "        max_tokens=1024,\n",
    "        messages=context,\n",
    "        model=\"claude-3-7-sonnet-latest\",\n",
    "    )\n",
    "    return response.content[0].text\n",
    "\n",
    "\n",
    "def generate_find_command(query_shape):\n",
    "    !sleep 5\n",
    "    context = base_context.copy()\n",
    "    context.extend([\n",
    "        {\n",
    "            \"role\": \"user\",\n",
    "            \"content\": f\"Here is an example Query Shape from the $queryStats output. It is for the find command. Compose a db.find() pymongo command from the Query Shape. Use projection or sorting if needed. Use plaintext, return only the python code. Make the query in one line of code. Do not use markdown code blocks.\",\n",
    "        },\n",
    "        {\n",
    "            \"role\": \"user\",\n",
    "            \"content\": f\"Query stats: {query_shape}\",\n",
    "        },\n",
    "        {\n",
    "            \"role\": \"user\",\n",
    "            \"content\": 'Example output: db.find({\"genres\": {\"$in\": [\"Animation\", \"Short\"]},\"poster\": None},{\"_id\": 1, \"title\": 1})',\n",
    "        }\n",
    "    ])\n",
    "\n",
    "    response = anthropic_client.messages.create(\n",
    "        max_tokens=1024,\n",
    "        messages=context,\n",
    "        model=\"claude-3-7-sonnet-latest\",\n",
    "    )\n",
    "    return response.content[0].text\n",
    "\n",
    "\n",
    "def add_details_to_query_stats(namespace, query_stats):\n",
    "    shape = query_stats[\"shape\"]\n",
    "\n",
    "    warnings = []\n",
    "    is_modification_pipeline = bool(re.search(\"merge|out\", f'{shape}'))\n",
    "    if is_modification_pipeline:\n",
    "        warnings.append(\"#⚠️Warning! This query is using $out or $merge stage and will modify data.\")\n",
    "\n",
    "    query_example = \"[] #TODO\"\n",
    "    if shape[\"command\"] == \"aggregate\":\n",
    "        query_example = shape[\"pipeline\"]\n",
    "    elif shape[\"command\"] == \"find\":\n",
    "        query_example = generate_find_command(shape)\n",
    "        warnings.append(\"#⚠️Warning! This query example was generated by AI.\")\n",
    "    if len(warnings) > 0:\n",
    "        query_example = \"[] #\" + query_example\n",
    "\n",
    "    query_description = get_query_header(shape)\n",
    "    query_details = get_query_details(query_stats[\"raw\"])\n",
    "\n",
    "    return {\n",
    "        \"query_hash\": query_stats[\"hash\"],\n",
    "        \"query_example\": query_example,\n",
    "        \"query_index\": \"{'_id': 1} #TODO: design an index for this query\",\n",
    "        \"query_short_description\": query_description,\n",
    "        \"query_details\": query_details,\n",
    "        \"warnings\": \"\\n\".join(warnings),\n",
    "    }\n",
    "\n",
    "\n",
    "def create_summary_notebook(namespace):\n",
    "    SUMMARY_TEMPLATE_PATH = \"mongodb-advisor-summary-template.ipynb\"\n",
    "    with open(SUMMARY_TEMPLATE_PATH, \"r\") as f:\n",
    "        summary_nb = nbformat.read(f, as_version=nbformat.NO_CONVERT)\n",
    "\n",
    "    header_cell = summary_nb.cells[0]\n",
    "    header_cell.source = Template(header_cell.source).safe_substitute(namespace)\n",
    "    setup_cell = summary_nb.cells[1]\n",
    "    setup_cell.source = Template(setup_cell.source).safe_substitute(namespace)\n",
    "\n",
    "    path = f'generated/{namespace[\"cluster_name\"]}/{namespace[\"database_name\"]}.{namespace[\"collection_name\"]}.ipynb'\n",
    "    os.makedirs(os.path.dirname(path), exist_ok=True)\n",
    "\n",
    "    print(path)\n",
    "    with open(path, \"w\") as f:\n",
    "        nbformat.write(summary_nb, f)\n",
    "\n",
    "\n",
    "def create_query_notebook(query_stats):\n",
    "    QUERY_TEMPLATE_PATH = \"mongodb-advisor-query-template.ipynb\"\n",
    "    with open(QUERY_TEMPLATE_PATH, \"r\") as f:\n",
    "        query_nb = nbformat.read(f, as_version=nbformat.NO_CONVERT)\n",
    "\n",
    "    header_cell = query_nb.cells[0]\n",
    "    header_cell.source = Template(header_cell.source).safe_substitute(query_stats)\n",
    "    setup_cell = query_nb.cells[1]\n",
    "    setup_cell.source = Template(setup_cell.source).safe_substitute(query_stats)\n",
    "\n",
    "    placeholder_index = 2\n",
    "    query_description_cell = query_nb.cells[placeholder_index].source\n",
    "    query_code_cell = query_nb.cells[placeholder_index + 1].source\n",
    "    del query_nb.cells[placeholder_index:placeholder_index + 2]\n",
    "\n",
    "    description = Template(query_description_cell).safe_substitute(query_stats)\n",
    "    code = Template(query_code_cell).safe_substitute(query_stats)\n",
    "    query_nb.cells.insert(placeholder_index, nbformat.v4.new_code_cell(code))\n",
    "    query_nb.cells.insert(placeholder_index, nbformat.v4.new_markdown_cell(description))\n",
    "\n",
    "    path = f'generated/{query_stats[\"cluster_name\"]}/queries/{query_stats[\"database_name\"]}/{query_stats[\"collection_name\"]}/{query_stats[\"query_hash\"][1:]}.ipynb'\n",
    "    os.makedirs(os.path.dirname(path), exist_ok=True)\n",
    "\n",
    "    print(path)\n",
    "    with open(path, \"w\") as f:\n",
    "        nbformat.write(query_nb, f)\n",
    "\n"
   ],
